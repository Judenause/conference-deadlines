rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isDeadlineAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/adminUsers/$(request.auth.uid));
    }

    function hasFields(required, optional) {
      return request.resource.data.keys().hasAll(required) &&
        request.resource.data.keys().hasOnly(required.concat(optional));
    }

    match /adminUsers/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /conferenceRequests/{requestId} {
      allow create: if isDeadlineAdmin() &&
        hasFields(
          ['name', 'officialUrl', 'category', 'note', 'submittedBy', 'submittedAt', 'status'],
          []
        ) &&
        request.resource.data.submittedBy == request.auth.token.email &&
        request.resource.data.status == 'submitted';
      allow read, update, delete: if isDeadlineAdmin();
    }

    match /scheduleOverrides/{overrideId} {
      allow create: if isDeadlineAdmin() &&
        hasFields(
          ['editionId', 'deadlineId', 'value', 'evidenceUrl', 'note', 'submittedBy', 'submittedAt', 'status'],
          []
        ) &&
        request.resource.data.submittedBy == request.auth.token.email &&
        request.resource.data.status == 'submitted';
      allow read, update, delete: if isDeadlineAdmin();
    }
  }
}
